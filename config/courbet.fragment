# courbet (SM7150) bring-up overrides, merged on top of config/base.config.
#
# The base config is the postmarketOS sm7150 config, which ships with the
# courbet panel disabled. That single symbol is the difference between a
# headless build and one that can show us anything at all.

# --- panel: K9A 36 02 0A, courbet's 1080x2400@90Hz DSC cmd-mode AMOLED ---
CONFIG_OF=y
CONFIG_DRM_MIPI_DSI=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_K9A_36_02_0A=y

# --- display stack ---
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_KMS=y
CONFIG_DRM_MSM_MDSS=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_10NM_PHY=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_MSM_KMS_FBDEV=y

# --- fbcon: the only debug channel visible without UART hardware ---
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# --- pstore/ramoops: logs survive a warm reboot into recovery ---
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_COMPRESS=y

# --- USB gadget: interactive shell over a COM port on the host ---
CONFIG_CONFIGFS_FS=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_TYPEC=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_TYPEC_MUX_FSA4480=y

# --- initramfs ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# --- storage: courbet boots from UFS, sdhc_2 is the microSD slot ---
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y

# --- SoC: clocks, pinctrl, interconnect, regulators, console ---
CONFIG_ARCH_QCOM=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_SM_GCC_7150=y
CONFIG_SM_DISPCC_7150=y
CONFIG_SM_VIDEOCC_7150=y
CONFIG_SM_CAMCC_7150=y
CONFIG_PINCTRL_SM7150=y
CONFIG_PINCTRL_SM7150_LPASS_LPI=y
CONFIG_INTERCONNECT_QCOM_SM7150=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_QCOM_GENI_SE=y

# --- touch: courbet's live controller is SPI (xiaomi,spits), not the i2c
# goodix/fts nodes that downstream carries as dead boilerplate ---
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8=y
CONFIG_TOUCHSCREEN_NT36XXX_SPI=y
CONFIG_TOUCHSCREEN_ST_FTS_V521=y
CONFIG_SPI=y
CONFIG_SPI_QCOM_QSPI=y
CONFIG_SPI_GENI_QCOM=y

# --- debug ---
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DEBUG_FS=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_KERNEL=y

CONFIG_LOCALVERSION="-courbet"
# CONFIG_LOCALVERSION_AUTO is not set