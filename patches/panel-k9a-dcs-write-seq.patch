--- a/drivers/gpu/drm/panel/panel-k9a-36-02-0a-mp-dsc.c
+++ b/drivers/gpu/drm/panel/panel-k9a-36-02-0a-mp-dsc.c
@@ -16,6 +16,24 @@
 #include <drm/drm_mipi_dsi.h>
 #include <drm/drm_modes.h>
 #include <drm/drm_panel.h>
+
+/*
+ * mipi_dsi_dcs_write_seq() was removed from <drm/drm_mipi_dsi.h>, but this
+ * generated panel driver still calls it 54 times. Re-add it locally in terms
+ * of mipi_dsi_dcs_write_buffer(), which is still present and gives the same
+ * semantics the old macro had, including the early return on error. Guarded
+ * so the same patch also applies to older trees that still define it.
+ */
+#ifndef mipi_dsi_dcs_write_seq
+#define mipi_dsi_dcs_write_seq(dsi, seq...) \
+	do { \
+		static const u8 d[] = { seq }; \
+		ssize_t ret; \
+		ret = mipi_dsi_dcs_write_buffer(dsi, d, ARRAY_SIZE(d)); \
+		if (ret < 0) \
+			return ret; \
+	} while (0)
+#endif
 
 struct k9a_36_02_0a_mp_dsc {
 	struct drm_panel panel;
